FROM golang:1.21-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ ./api/
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /ingest-service ./cmd/ingest-service

FROM alpine:3.19
RUN addgroup -S ingest && adduser -S ingest -G ingest
USER ingest
COPY --from=builder /ingest-service /usr/local/bin/ingest-service
EXPOSE 8001 9001
ENTRYPOINT ["ingest-service"]
